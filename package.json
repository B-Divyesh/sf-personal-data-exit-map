{
  "name": "personal-data-exit-map",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:claims": "playwright test tests/e2e/claims.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts --max-warnings=0",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.4",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
